<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>

    <style name="AmbientWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/ambient_enter</item>
        <item name="android:windowExitAnimation">@anim/ambient_exit</item>
    </style>

    <!-- Small spaced-out caps used for card titles, e.g. "CURRENT WEATHER" -->
    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#A6A6A6</item>
    </style>

    <style name="CardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#E6E6E6</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ForecastDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ForecastDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/divider</item>
    </style>
</resources>
